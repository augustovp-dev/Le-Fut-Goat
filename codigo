// ================= DATABASE =================
CREATE DATABASE lefutgoat;
USE lefutgoat;

CREATE TABLE users (
 id INT AUTO_INCREMENT PRIMARY KEY,
 email VARCHAR(100),
 password VARCHAR(100)
);

CREATE TABLE players (
 id INT AUTO_INCREMENT PRIMARY KEY,
 name VARCHAR(100),
 goals INT
);

// ================= APP =================
const express = require('express');
const session = require('express-session');
const path = require('path');

const app = express();

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.use(session({
 secret: 'goat',
 resave: false,
 saveUninitialized: false
}));

app.use(express.static(path.join(__dirname, 'src/public')));

app.use('/user', require('./src/routes/userRoutes'));
app.use('/players', require('./src/routes/playerRoutes'));

app.listen(3000, () => console.log('http://localhost:3000'));

// ================= AUTH =================
function auth(req, res, next) {
 if (req.session.user) next();
 else res.status(401).send('Não autorizado');
}
module.exports = auth;

// ================= USER =================
const db = require('../config/database');

exports.login = (req, res) => {
 const { email, password } = req.body;
 db.query('SELECT * FROM users WHERE email=? AND password=?',
 [email, password],
 (err, result) => {
  if (result.length > 0) {
   req.session.user = result[0];
   res.send(true);
  } else res.send(false);
 });
};

exports.register = (req, res) => {
 const { email, password } = req.body;
 db.query('INSERT INTO users (email,password) VALUES (?,?)',
 [email, password], () => res.send(true));
};

// ================= PLAYERS =================
exports.listPlayers = (req, res) => {
 db.query('SELECT * FROM players', (e, r) => res.json(r));
};

